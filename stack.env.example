# Loki push endpoint. Default uses host.docker.internal (Loki bound on apple-pi:3100).
LOKI_URL=http://host.docker.internal:3100

# Stripe webhook signing secret — from https://dashboard.stripe.com/webhooks
# Leave blank to return 503 on /webhooks/stripe (useful for staged rollout).
STRIPE_WEBHOOK_SECRET=

# Resend webhook signing secret — from https://resend.com/webhooks
# Resend uses Svix (svix-id / svix-timestamp / svix-signature headers).
RESEND_WEBHOOK_SECRET=
